#Ist die Datenbank Lokal?
DB_IS_LOCAL=True

# Passwort für den "spacetrader"-Postgres-User
DB_PASSWORD=

# Passwort für den "airflow"-Postgres-User
AIRFLOW_DB_PASSWORD=

# Passwort für den Airflow-Admin-Login (Webserver-UI)
AIRFLOW_ADMIN_PASSWORD=

# Host-UID, unter der die Airflow-Container laufen (Dateiberechtigungen für
# die gemounteten airflow/-Ordner). Airflow empfiehlt 50000 als sicheren
# Default, gerade unter Windows/Docker Desktop.
AIRFLOW_UID=


# Spacetrader-API-Key (für die Nutzung der SpaceTrader-API)
# Account Token
SPACETRADER_ACCOUNT_KEY=
